# Copia este archivo como backend/.env para desarrollo local.
# En Render, configura estas variables en el Environment del servicio backend.
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
JWT_SECRET=

# Opcionales: correo y tarea programada
RESEND_API_KEY=
EMAIL_FROM=
CRON_SECRET=

# Render asigna PORT automáticamente; solo úsalo en desarrollo local.
PORT=3001
